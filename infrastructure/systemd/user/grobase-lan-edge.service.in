# Rendered and installed by `make link-autostart LAN_IF=<iface>` (opt-in: it puts the WAF,
# port 8443 only, on this host's LAN). Rollback: make link-autostart-off.
# What it forwards and why only 8443: scripts/grobase-lan-edge.sh.
[Unit]
Description=grobase WAF on the LAN (8443 only)
After=network-online.target b2b-vm-baas.service

[Service]
Environment=LAN_IF=@LAN_IF@
Environment=VM_PORTS_FILE=@VM_PORTS_FILE@
ExecStart=/usr/bin/bash @GROOT@/scripts/grobase-lan-edge.sh
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
