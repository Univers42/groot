# Rendered and installed by `make publish-socket HOST_KEY_FILE=<file with the VM's ssh host
# public key line>` (opt-in host unit; scripts/osionos-publish-socket.sh), removed by `make
# publish-socket-off`. Why: the osionos bridge's co-edit publishes reach the realtime gateway
# through Kong on the data center VM; over Tailscale that hop measured ~10 ms p50, through this
# local ssh -L forward 0.43 ms p50 (2026-10-27). The risk ruling (devil, 2026-10-27) allows it
# under its conditions: the pinned batch-only ssh of this ExecStart (S1/S2; nothing is read from
# ~/.ssh/config: -F none, no agent: IdentityAgent=none, no global known_hosts: the pin is the only
# trust), the persistent 0700 state paths it renders with (S6/S7), and nothing
# but this template committed, never a rendered copy (S13).
# Caveat: the forward carries only what reaches the socket; if the VM's sshd host key changes
# (VM rebuilt) this unit refuses to connect (StrictHostKeyChecking=yes against the pinned
# HostKeyAlias) until the operator re-pins it (`make publish-socket HOST_KEY_FILE=<fresh file>`),
# and the bridge falls back to the tailnet route meanwhile.
[Unit]
Description=osionos publish socket: local ssh -L forward of the VM's Kong (8000) to a unix socket
After=b2b-vm-baas.service
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh \
-F none -N -T -p 4242 -i @IDENTITY@ \
-o BatchMode=yes -o IdentitiesOnly=yes -o IdentityAgent=none -o ControlMaster=no -o ControlPath=none \
-o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes -o StreamLocalBindMask=0177 \
-o ServerAliveInterval=5 -o ServerAliveCountMax=3 \
-o StrictHostKeyChecking=yes -o UserKnownHostsFile=@KNOWN_HOSTS@ -o GlobalKnownHostsFile=/dev/null -o HostKeyAlias=b2b-publish \
-L @SOCKET_DIR@/kong.sock:127.0.0.1:8000 \
@SSH_USER@@127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
