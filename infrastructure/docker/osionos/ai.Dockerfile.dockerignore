# Context = ./apps/osionos/app (the osionos submodule). The AI service needs
# its own package files and sources, plus the four bridge modules its sources
# import (see the header of ai.Dockerfile). Everything else is noise — and the
# node_modules of the app would be copied into the image otherwise.
node_modules
**/node_modules
.git
build
dist
test-results
playwright-report
docs
public
vendor
src
tests
# The scripts/ directory holds ninety-odd modules; the service imports five.
# They are re-included one by one, so the closure is visible in both files.
scripts/*
!scripts/bridge-session-token.mjs
!scripts/bridge-session-cutoff.mjs
!scripts/bridge-baas-body.mjs
!scripts/bridge-page-read.mjs
!scripts/bridge-live-workspaces.mjs
services/osionos-ai/tests
services/osionos-ai/node_modules
