# osionos IDE sandbox daemon — a SECOND, isolated Docker daemon.
#
# It runs the per-(user,workspace) IDE sandboxes on its OWN data-root, so a
# sandbox/provisioner compromise can never see the mini-baas backend containers
# on the main daemon (devil condition 1). It is rootful (like the main daemon)
# but `--userns-remap=default` maps container-root to an unprivileged host uid,
# so a container escape does NOT yield host root.
#
# TWO-DAEMON SAFETY: distinct data-root/exec-root/pidfile + a non-overlapping
# bridge subnet. The SOCKET is not this daemon's: systemd owns
# /run/docker-ide.sock (docker-ide.socket, Required and After below) and passes
# the open file to this daemon as `fd://`, so a restart never hands the proxy's
# bind-mount a stale inode, and the socket unit's 0660 root:docker mode is what
# replaces the old `--group=docker`. `--iptables=false` so this daemon NEVER
# touches the main daemon's DOCKER/DOCKER-USER chains (a shared-iptables race
# could break the backend). The sandbox network is `--internal` (L2 only, no NAT
# needed); the in-daemon egress proxy's outbound NAT is a single scoped rule
# installed separately (ide-egress-nat.sh), never via this daemon.
# `--containerd-namespace=osionos-ide` (plus the separate plugins namespace
# `osionos-ide-plugins`) keeps this daemon's containers in their own containerd
# namespaces on the SHARED system containerd, so the two daemons never see each
# other's containers at the containerd level; and
# `--config-file=/etc/docker-ide/daemon.json` keeps it from reading the MAIN
# daemon's /etc/docker/daemon.json. The whole plane (daemon + every box) is
# capped as one group by osionos-ide.slice.
#
# Install (operator, once):
#   sudo sh infrastructure/docker/osionos/ide-sandbox/install-docker-ide.sh
# Requires the loopback prjquota data-root mounted at /var/lib/docker-ide first
# (see README.md "Activation").

[Unit]
Description=osionos IDE isolated Docker daemon
After=network-online.target
After=osionos-ide.slice
Wants=network-online.target
Requires=osionos-ide.slice
# systemd owns the socket file; this daemon inherits it as fd:// instead of
# creating (and recreating on every restart) /run/docker-ide.sock itself.
Requires=docker-ide.socket
After=docker-ide.socket
# Must not start before the quota-backed data-root is mounted.
RequiresMountsFor=/var/lib/docker-ide

[Service]
Type=notify
# The daemon itself counts against the slice's memory/CPU/IO cap.
Slice=osionos-ide.slice
ExecStart=/usr/bin/dockerd \
  --data-root=/var/lib/docker-ide \
  --exec-root=/run/docker-ide \
  --host=fd:// \
  --pidfile=/run/docker-ide.pid \
  --userns-remap=default \
  --iptables=false \
  --ip-forward=true \
  --bridge=none \
  --default-address-pool base=10.202.0.0/16,size=24 \
  --storage-driver=overlay2 \
  --cgroup-parent=osionos-ide.slice \
  --containerd-namespace=osionos-ide \
  --containerd-plugins-namespace=osionos-ide-plugins \
  --config-file=/etc/docker-ide/daemon.json
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3
Delegate=yes
KillMode=process
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity

[Install]
WantedBy=multi-user.target
