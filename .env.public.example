# .env.public — public mode: the frontends served to the internet through this host's
# Tailscale Funnel (make public-env creates ./.env.public from this file; git-ignored,
# mode 600). KEY=value, no quotes. wiki/runbooks/public-funnel.md has the order of steps.

# PUBLIC_ORIGIN — the node's Funnel origin, no trailing slash. Its host part must equal the
# Tailscale node name (`make public-verify` compares it with `tailscale status`).
# 443 serves the website, :8443 the osionos app, :10000 the bridge.
PUBLIC_ORIGIN=https://osionos.tail10f2ea.ts.net

# AUTH_LINK_SIGNING_KEY — signs the emailed links; at least 32 characters, distinct from every
# other secret. `make public-env` mints one with openssl; it is never printed.
AUTH_LINK_SIGNING_KEY=

# OSIONOS_ADMIN_EMAILS — who is admin in the public bridge. Required, no default (the bridge's
# own default is a real address). Comma-separated emails, or the literal `none` for nobody.
OSIONOS_ADMIN_EMAILS=

# AUTH_MAIL_DAILY_CAP — most mails the gateway sends per day (verification links cost real
# Titan quota). Default 50; a value above 50 is refused by `make public-verify`.
AUTH_MAIL_DAILY_CAP=50

# AUTH_TRUSTED_PROXY_HOPS — reverse proxies in front of the gateway whose X-Forwarded-For
# entry is trusted. Required, no default: it is MEASURED on the live path (Funnel, then
# local-https-proxy, then opposite-osiris-web), and a wrong value lets a client forge its
# rate-limit identity. Open 443 with a provisional value, measure, correct it, then `all`.
# `public-funnel.sh up all` refuses while it is empty.
AUTH_TRUSTED_PROXY_HOPS=

# AUTH_SIGNUP_OPEN — whether anyone may register. AUTH_REGISTER_RATE_LIMIT_PER_HOUR (integer, 1 to 10)
# caps registrations per client IP per hour.
AUTH_SIGNUP_OPEN=true
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=10

# AUTH_VERIFICATION_EXEMPT — exact addresses (comma-separated, at most 10, no domains or
# wildcards) that are never mailed a verification link and are signed in emailVerified:false;
# for test accounts on addresses nobody can read. The gateway refuses to boot with it while
# AUTH_LOGIN_EMAIL_OTP=true, and `make public-verify` FAILs if an entry is also an admin
# in OSIONOS_ADMIN_EMAILS.
AUTH_VERIFICATION_EXEMPT=dylan@gmail.com
