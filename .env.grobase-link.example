# .env.grobase-link — how the frontends on THIS machine reach grobase (make link).
# Copy it to ./.env.grobase-link (git-ignored) and set the target. KEY=value, no quotes, no
# `export`. The environment and `make link KEY=value` win over this file for one run; a key
# that is absent takes the default shown. wiki/runbooks/grobase-link.md has the detail.

# GROBASE_TARGET — where grobase is. The scheme is the kind of connection.
#   auto                       this Docker daemon when it runs mini-baas-kong, else the first
#                              ~/.ssh/config alias or born2root VM that does (the default)
#   local                      monolithic: grobase on this daemon (make backend-up / make all)
#   ssh://[user@]host[:port]   any machine ssh reaches: the born2root VM (ssh://b2b), a box on
#                              the LAN, a VPS, a tailnet peer by its MagicDNS name. All five
#                              grobase ports are relayed (Kong, Redis, Mailpit smtp+http, realtime)
#   <alias> | user@host | host tried as ssh, then http://host:8000, then https://host
#   http(s)://host[:port]      a Kong URL across the internet (Tailscale Funnel, a reverse proxy).
#                              Kong over the URL, with Redis and Mailpit stood in on this machine
#                              (sessions and captured mail stay here); realtime is not relayed, so
#                              bridge publishes are dropped. Secrets cannot be fetched this way: put
#                              that grobase's .env at ./.env.grobase-remote first
GROBASE_TARGET=ssh://b2b

# Loopback copy of Kong on 127.0.0.1 for host tools and `make link-healthcheck`; 0 = none.
GROBASE_LINK_HOST_PORT=28000

# ssh targets only: the grobase checkout on that machine, whose .env holds the secrets.
GROBASE_REMOTE_DIR=/opt/grobase

# GROBASE_API_URL — the HTTPS URL clients use for the grobase API (the WAF), e.g. the VM's
# MagicDNS name: https://<vm>.<tailnet>.ts.net:8443. Empty = derived from GROBASE_TARGET
# (local -> https://127.0.0.1:8443, http(s):// -> that URL); ssh and auto targets need it.
GROBASE_API_URL=

# GROBASE_CA_FILE — direct targets only (http(s)://): the PEM CA that signs that Kong's
# certificate, e.g. the data center's certs/track-binocle-local-ca.pem copied to this
# machine. The relay verifies Kong against it instead of its system store, which knows
# public CAs only, so leave it empty for a Kong behind a public CA. The CA certificate is
# public: copy it, never its KEY, which never leaves the data center.
GROBASE_CA_FILE=

# GROBASE_IDE_SSH — direct targets only (http(s)://): an ssh alias or user@host of the machine that
# runs the IDE plane (compose project osionos-ide-plane). `make link` then also opens an ssh master
# to it and forwards one unix socket to osionos-ide-server:4100, so the IDE terminal works.
# It routes NO BaaS traffic: Kong, realtime, Redis and Mailpit keep going the direct way, and a
# master that will not open only costs the IDE (a note, the link still succeeds). Empty = no ssh at
# all. Ignored in ssh and local modes. A plain alias only: letters, digits and . _ @ : -, not
# starting with "-".
# GROBASE_IDE_SSH=b2b
