---
import StatChip from '../ui/StatChip.astro';
---

<section class="gb-section gb-hero" aria-labelledby="hero-title">
	<div class="gb-container">
		<p class="gb-kicker">Open-source backend · self-host or cloud</p>
		<h1 id="hero-title">One backend for <em>everything</em> you build.</h1>
		<p class="gb-lede">
			Accounts, database, realtime, files, search and functions — over any database engine.
			Start on a 5 MB binary on a spare machine, grow to thousands of customers on one stack,
			and never rewrite to get there.
		</p>
		<div class="gb-hero__ctas">
			<a class="gb-btn gb-btn--primary" href="/pricing/">Start free</a>
			<a class="gb-btn gb-btn--ghost" href="#usecases">What are you building?</a>
		</div>
		<div class="gb-hero__stats">
			<StatChip value="5 MB" label="single binary to start" />
			<StatChip value="8 engines" label="one simple API" />
			<StatChip value="10K+ tenants" label="on one stack" />
			<StatChip value="$0 idle" label="open-source, self-host" />
		</div>
	</div>
</section>
