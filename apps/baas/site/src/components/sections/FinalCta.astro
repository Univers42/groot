---
import { SITE } from '../../data/site';
---

<section class="gb-section" aria-labelledby="cta-title">
	<div class="gb-container gb-cta-final">
		<p class="gb-kicker">Ready when you are</p>
		<h2 id="cta-title">Build the backend your project actually needs.</h2>
		<p class="gb-lede">
			A weekend project on a 5 MB binary, or thousands of customers on one stack — it's the same
			code and the same simple API. The numbers are public, and the upgrade path is real.
		</p>
		<div class="gb-hero__ctas">
			<a class="gb-btn gb-btn--primary" href="/pricing/">Start free on Nano</a>
			<a class="gb-btn gb-btn--ghost" href={SITE.repoUrl} rel="noopener">Explore the source</a>
		</div>
	</div>
</section>
