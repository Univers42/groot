{
  "name": "osionos-desktop",
  "productName": "osionos",
  "version": "0.5.4",
  "description": "osionos — the Track Binocle editor + app suite (Electron shell)",
  "main": "main.js",
  "author": "Track Binocle",
  "license": "MIT",
  "homepage": "https://github.com/Univers42/prismatica",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "dist": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:all": "electron-builder --linux deb AppImage --win nsis",
    "dist:native": "electron-builder --config electron-builder.native.json --linux deb AppImage"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.trackbinocle.osionos",
    "productName": "osionos",
    "executableName": "osionos",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "desktop-guards.js", "desktop-proxy.js", "desktop-pty.js", "pty-host.js", "desktop-config.json", "renderer/**/*", "node_modules/node-pty/**/*"],
    "asarUnpack": ["node_modules/node-pty/**/*"],
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Office",
      "icon": "icon.png",
      "maintainer": "Track Binocle"
    },
    "deb": { "afterInstall": "deb-after-install.tpl", "depends": ["libgtk-3-0t64 | libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils"] },
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "osionos"
    }
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
